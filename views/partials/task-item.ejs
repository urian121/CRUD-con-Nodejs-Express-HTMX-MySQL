<tr id="task-<%= task.id %>" class="<%= task.completed ? 'task-completed' : '' %>">
  <td class="text-center">
    <div class="d-flex justify-content-center align-items-center">
      <div class="form-check form-switch">
        <input class="form-check-input" 
          type="checkbox" 
          id="complete-<%= task.id %>"
          hx-patch="/api/tasks/<%= task.id %>/toggle" hx-vals="js:{
            id: '<%= task.id %>',
            completed: event.target.checked ? '1' : '0'
            }" 
            hx-target="#task-<%= task.id %>"
            hx-trigger="change" hx-swap="outerHTML"
            <%= task.completed ? 'checked' : '' %>>
        <label class="form-check-label" for="complete-<%= task.id %>">
          <%= task.completed ? 'Completada' : 'Pendiente' %>
        </label>
      </div>
    </div>
  </td>
  <td>
    <%= task.title.length> 50 ? task.title.substring(0, 50) + '...' : task.title %>
  </td>
  <td>
    <% if (task.description && task.description.trim() !== '') { %>
      <span class="task-description" title="<%= task.description %>">
        <%= task.description.length > 50 ? task.description.substring(0, 50) + '...' : task.description %>
      </span>
    <% } else { %>
      <span class="task-description fst-italic">Sin descripción</span>
    <% } %>
  </td>
  <td>
    <span class="task-date" data-order="<%= new Date(task.created_at).getTime() %>">
      <%= new Date(task.created_at).toLocaleDateString('es-ES', { 
        year: 'numeric', 
        month: '2-digit', 
        day: '2-digit'
      }) %>
    </span>
  </td>
  
  <!-- Acciones -->
  <td>
    <div class="action-buttons">
      <!-- Botón Ver/Detalles -->
      <button type="button" 
              class="btn btn-outline-info btn-sm me-1" 
              data-bs-toggle="modal" 
              data-bs-target="#modal-view-task"
              hx-get="/api/tasks/<%= task.id %>/view"
              hx-target="#view-task-content"
              title="Ver detalles">
        <i class="bi bi-eye"></i>
      </button>
      
      <!-- Botón Editar -->
      <button type="button" 
              class="btn btn-outline-warning btn-sm me-1" 
              data-bs-toggle="modal" 
              data-bs-target="#editTaskModal"
              hx-get="/api/tasks/<%= task.id %>"
              hx-target="#edit-modal-content"
              title="Editar tarea">
        <i class="bi bi-pencil"></i>
      </button>
      
      <!-- Botón Eliminar -->
      <button type="button" 
              class="btn btn-outline-danger btn-sm"
              data-bs-toggle="modal" 
              data-bs-target="#modal-delete"
              onclick="setupDeleteModal('<%= task.id %>', '<%= task.title %>')"
              title="Eliminar tarea">
        <i class="bi bi-trash"></i>
      </button>
    </div>
  </td>
</tr>