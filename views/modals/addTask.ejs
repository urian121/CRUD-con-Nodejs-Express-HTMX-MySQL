<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h3 class="modal-title text-center w-100" id="addTaskModalLabel">
                    Registro de Nueva Tarea
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Spinner fuera del <form> para que no se borre -->
                <div id="spinnerModal" class="d-flex flex-column align-items-center my-3 d-none">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <span>Cargando...</span>
                </div>
                
                <form autocomplete="off" id="addTaskForm"
                        hx-post="/api/tasks" 
                        hx-target="#tasksTable tbody" 
                        hx-swap="afterbegin" 
                        hx-on::before-request="
                        document.querySelector('#spinnerModal').classList.remove('d-none');
                        document.querySelector('#addTaskForm').classList.add('d-none');
                        " 
                        hx-on::after-request="
                        setTimeout(() => {
                            const modal = bootstrap.Modal.getInstance(document.querySelector('#addTaskModal'));
                            if(modal) modal.hide();
                            document.querySelector('#spinnerModal').classList.add('d-none');
                            document.querySelector('#addTaskForm').classList.remove('d-none');
                            document.querySelector('#addTaskForm').reset();
                        }, 800);
                        ">
                    <div class="mb-3">
                        <label for="title" class="form-label">Título</label>
                        <input type="text" class="form-control" id="title" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Descripción</label>
                        <textarea class="form-control" id="description" name="description" rows="4"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-node">
                            Agregar Tarea
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>