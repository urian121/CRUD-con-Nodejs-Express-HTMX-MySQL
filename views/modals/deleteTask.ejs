<div class="modal fade" id="deleteToastModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title w-100 text-center opacity-75">
                    Eliminar tarea
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Spinner fuera del <form> para que no se borre -->
                <div id="spinnerModalDelete" class="d-flex flex-column align-items-center justify-content-center my-3 d-none">
                    <div class="spinner-border mb-2" role="status"></div>
                    <span class="fs-5">Eliminando...</span>
                </div>

                <p id="confirmDelete" class="d-block">¿Seguro que desea eliminar la tarea "<span id="task-title-to-delete"></span>"?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" 
                        id="confirm-delete-btn"
                        class="btn btn-danger"
                        hx-swap="outerHTML"
                        hx-indicator="#spinnerModalDelete"
                        hx-on::before-request="
                            document.querySelector('#spinnerModalDelete').classList.remove('d-none');
                            document.querySelector('#confirmDelete').classList.add('d-none');
                            document.querySelector('.modal-footer').classList.add('d-none');
                        " 
                        hx-on::after-request="
                        setTimeout(() => {
                            document.querySelector('#spinnerModalDelete').classList.add('d-none');
                            document.querySelector('#confirmDelete').classList.remove('d-none');
                            document.querySelector('.modal-footer').classList.remove('d-none');

                            if (event.detail.successful) {
                                const modalEl = document.querySelector('#deleteToastModal');
                                const modal = bootstrap.Modal.getInstance(modalEl);
                                if(modal) modal.hide();
                            } else {
                                console.log('Error en la eliminación:', event.detail);
                            }
                        }, 800);
                        ">
                    Eliminar <i class="bi bi-trash3"></i>
                </button>
            </div>
        </div>
    </div>
</div>